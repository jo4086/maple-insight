import type { MainItemEquipment, PresetItemEquipment, ItemPresets, CharacterAndroid } from '@maple/types';
import { useMemo, useState } from 'react';
import { twMerge } from 'tailwind-merge';

import { EQUIPMENT_LAYOUT } from '../../types/equipment';

import { EquipmentSlot } from './EquipmentSlot';

type EquipmentGridProps = {
  characterImg: string;
  items: MainItemEquipment[];
  initialPresetNo?: number;
  presets: ItemPresets[];
  android: CharacterAndroid;
};

type EquipmentItem = MainItemEquipment | PresetItemEquipment;

const normalizeEquipmentSlot = (slot: string) => {
  const normalized = slot.replaceAll(' ', '').trim();

  if (normalized === '펜던트1') return '펜던트';

  return normalized;
};

export const EquipmentGrid = ({ characterImg, items, initialPresetNo = 1, presets, android }: EquipmentGridProps) => {
  const [selectedPresetNo, setSelectedPresetNo] = useState(initialPresetNo);

  const presetItemsByNo = useMemo(() => {
    const presetMap = new Map<number, EquipmentItem[]>();

    presets.forEach((preset) => {
      presetMap.set(preset.no, preset.info);
    });

    presetMap.set(initialPresetNo, items);

    return presetMap;
  }, [initialPresetNo, items, presets]);

  const preset1Items = useMemo(() => {
    if (initialPresetNo === 1) return items;
    return presetItemsByNo.get(1) ?? [];
  }, [initialPresetNo, items, presetItemsByNo]);

  const currentItems = useMemo(() => {
    if (selectedPresetNo === 1) return preset1Items;

    const preset1BySlot = new Map<string, EquipmentItem>();
    const selectedBySlot = new Map<string, EquipmentItem>();

    preset1Items.forEach((item) => {
      preset1BySlot.set(normalizeEquipmentSlot(item.slot), item);
    });

    (presetItemsByNo.get(selectedPresetNo) ?? []).forEach((item) => {
      selectedBySlot.set(normalizeEquipmentSlot(item.slot), item);
    });

    const mergedBySlot = new Map(preset1BySlot);

    selectedBySlot.forEach((item, slot) => {
      mergedBySlot.set(slot, item);
    });

    return Array.from(mergedBySlot.values());
  }, [preset1Items, presetItemsByNo, selectedPresetNo]);

  const currentAndroid = useMemo(() => {
    if (selectedPresetNo === android.presetNo) return android.equipped;
    return android.presets.find((preset) => preset.no === selectedPresetNo)?.info ?? null;
  }, [android, selectedPresetNo]);
  const equipmentBySlot = Object.fromEntries(currentItems.map((item) => [normalizeEquipmentSlot(item.slot), item]));

  return (
    <div className="grid grid-cols-7 grid-rows-6 gap-0.5">
      {EQUIPMENT_LAYOUT.map((cell) => {
        if (cell.slot === 'character-preview') {
          return (
            <div
              key={cell.slot}
              className="rounded-md border border-gray-200 bg-white/5 p-2"
              style={{
                gridColumn: `${cell.col} / span ${cell.colSpan ?? 1}`,
                gridRow: `${cell.row} / span ${cell.rowSpan ?? 1}`,
              }}
            >
              <div
                className={twMerge('h-full w-full origin-center bg-center bg-[length:175%] transition-transform duration-300 ease-out scale-150')}
                style={{ backgroundImage: `url(${characterImg})` }}
              />
            </div>
          );
        }

        const normalizedSlot = normalizeEquipmentSlot(cell.slot);
        const item = equipmentBySlot[normalizedSlot];
        const icon = cell.slot === '안드로이드' ? currentAndroid?.icon ?? item?.icon : item?.icon;

        return (
          <div
            key={cell.slot}
            style={{
              gridColumn: `${cell.col} / span ${cell.colSpan ?? 1}`,
              gridRow: `${cell.row} / span ${cell.rowSpan ?? 1}`,
            }}
          >
            <EquipmentSlot
              icon={icon}
              label={cell.slot}
              potentialOptionGrade={item?.potentials.potential.grade}
              additionalPotentialOptionGrade={item?.potentials.additional.grade}
            />
          </div>
        );
      })}

      {[1, 2, 3].map((presetNo) => {
        const hasPreset = presetNo === 1 ? preset1Items.length > 0 : (presetItemsByNo.get(presetNo) ?? []).length > 0 || preset1Items.length > 0;

        return (
          <div
            key={`preset-${presetNo}`}
            style={{
              gridColumn: `${presetNo + 2} / span 1`,
              gridRow: '6 / span 1',
            }}
            className="flex justify-center items-center"
          >
            <button
              type="button"
              onClick={() => setSelectedPresetNo(presetNo)}
              disabled={!hasPreset}
              className={twMerge(
                'flex h-7 w-7 items-center justify-center rounded-md border text-xs font-semibold tabular-nums transition',
                selectedPresetNo === presetNo ? 'border-gray-700 bg-gray-500 text-white' : 'border-white/10 bg-gray-300 text-gray-400 hover:bg-gray-400 hover:text-gray-700',
                !hasPreset && 'cursor-not-allowed opacity-40 hover:bg-gray-400 hover:text-gray-400',
              )}
            >
              {presetNo}
            </button>
          </div>
        );
      })}
    </div>
  );
};
