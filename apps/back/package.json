{
  "name": "maple-insight-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Maple Insight",
  "author": "jo4086",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true TS_NODE_PROJECT=tsconfig.json ts-node-dev --respawn --files src/index.ts",
    "dev3": "NODE_OPTIONS='--loader ts-node/esm' ts-node-dev --respawn --files src/index.ts",
    "dev2": "TS_NODE_PROJECT=tsconfig.json ts-node-dev --files src/index.ts",
    "build": "tsup",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "sync:domain-types": "ts-node scripts/sync-domain-types.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.19.2",
    "express-session": "^1.18.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "pm2": "^6.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@maple/types": "workspace:*",
    "@maple/utils": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.10",
    "csvtojson": "^2.0.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "vitest": "^4.0.18"
  }
}
