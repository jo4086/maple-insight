{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "module": "esnext", // 중요: ESM 전용으로 덮어쓰기
    // "moduleResolution": "bundler", // 중요: MCP Framework ESM 대응
    "baseUrl": ".",
    "outDir": "dist",
    "types": ["node"],
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "ts-node": {
    "files": true
  },
  "include": ["**/*.ts", "src"],
  "exclude": ["node_modules", "dist"]
}
