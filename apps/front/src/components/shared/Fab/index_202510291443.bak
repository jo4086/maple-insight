import cn from 'classnames';
import React, { useState, useRef, useEffect, useCallback } from 'react';
import { useNavigate } from 'react-router-dom';

type FabItem = { id: string; label: string; path: string };
type FabItems = FabItem[];

type ClassName = string;
type ClassNames = {
  actionBtn?: ClassName;
  list?: ClassName;
  item?: ClassName;
};

interface FabProps {
  /*
   * Fab main label
   */
  label?: string | React.ReactNode;
  /**
   * Fab list-item props
   * { id: react unique key, label: item label, path: route path }
   */
  items: FabItems;
  /**
   * tailwind classname style control
   * */
  classNames?: ClassNames;
}

export const Fab = (props: FabProps) => {
  const { label = 'action', items, classNames } = props;
  const actionBtn = classNames?.actionBtn ?? '';
  const list = classNames?.list ?? '';
  const listItem = classNames?.item ?? '';

  // const { actionBtn = '', list = '', item = '' } = classNames;

  const navigate = useNavigate();
  const fabRef = useRef<HTMLDivElement>(null);
  const dragStartTime = useRef(0);
  const hoverTimeoutRef = useRef<NodeJS.Timeout | null>(null);
  const leaveTimeoutRef = useRef<NodeJS.Timeout | null>(null); // To manage leaving the component

  const [isListVisible, setListVisible] = useState(false);
  const [isDragging, setDragging] = useState(false);
  const [position, setPosition] = useState(() => {
    const savedPosition = localStorage.getItem('fabPosition');
    if (savedPosition) {
      return JSON.parse(savedPosition);
    }
    return {
      x: window.innerWidth - 180,
      y: window.innerHeight - window.innerHeight * 0.9,
    };
  });
  const [dragStart, setDragStart] = useState({ x: 0, y: 0 });
  const [listDirection, setListDirection] = useState<'up' | 'down'>('up');
  const [ignoreNextClick, setIgnoreNextClick] = useState(false);

  const shouldSkipFab = (target: EventTarget | null) => {
    if (!(target instanceof HTMLElement)) return false;
    return Boolean(target.closest('[data-skip-fab="true"]'));
    // target instanceof HTMLElement && target.closest('[data-skip-fab="true"]');
  };

  const handleNavigate = (path: string) => {
    navigate(path);
  };

  const updateListDirection = useCallback(() => {
    if (fabRef.current) {
      const fabRect = fabRef.current.getBoundingClientRect();
      const spaceBelow = window.innerHeight - fabRect.bottom;
      // Estimate list height (item height + margin) * number of items
      const estimatedListHeight = (44 + 8) * items.length;

      if (spaceBelow < estimatedListHeight) {
        setListDirection('up');
      } else {
        setListDirection('down');
      }
    }
  }, [items.length]);

  const handleMouseEnter = (e: React.MouseEvent<HTMLDivElement>) => {
    if (shouldSkipFab(e.target)) return;
    if (leaveTimeoutRef.current) clearTimeout(leaveTimeoutRef.current);
    if (isDragging) return;

    hoverTimeoutRef.current = setTimeout(() => {
      if (isDragging) return; // Re-check in case drag started during timeout
      updateListDirection();
      setListVisible(true);
    }, 150); // 300ms delay
  };

  const handleMouseLeave = () => {
    if (hoverTimeoutRef.current) clearTimeout(hoverTimeoutRef.current);

    leaveTimeoutRef.current = setTimeout(() => {
      setListVisible(false);
    }, 200); // Delay hiding to allow moving mouse to the list
  };

  const onMouseDown = (e: React.MouseEvent<HTMLDivElement>) => {
    if (shouldSkipFab(e.target)) return;

    dragStartTime.current = Date.now();
    // Prevent text selection while dragging
    e.preventDefault();
    // Hide list immediately and cancel any pending show events
    if (hoverTimeoutRef.current) clearTimeout(hoverTimeoutRef.current);
    setListVisible(false);

    setDragging(true);
    setDragStart({
      x: e.clientX - position.x,
      y: e.clientY - position.y,
    });
  };

  const onMouseMove = useCallback(
    (e: MouseEvent) => {
      if (!isDragging) return;

      let newX = e.clientX - dragStart.x;
      let newY = e.clientY - dragStart.y;

      // Boundary checks
      const fabWidth = fabRef.current?.offsetWidth || 150;
      const fabHeight = fabRef.current?.offsetHeight || 50;

      if (newX < 0) newX = 0;
      if (newY < 0) newY = 0;
      if (newX + fabWidth > window.innerWidth) newX = window.innerWidth - fabWidth;
      if (newY + fabHeight > window.innerHeight) newY = window.innerHeight - fabHeight;

      setPosition({ x: newX, y: newY });
    },
    [isDragging, dragStart],
  );

  const onMouseUp = useCallback(
    (e: MouseEvent) => {
      if (isDragging) {
        e.stopPropagation(); // 이벤트 전파 차단
      }
      setDragging(false);
      localStorage.setItem('fabPosition', JSON.stringify(position));
    },
    [isDragging, position],
  );

  // const onMouseUp = useCallback(
  //   (e: MouseEvent) => {
  //     const pressDuration = Date.now() - dragStartTime.current;
  //     if (isDragging && pressDuration > 150) {
  //       // 150ms 이상 눌렀으면 드래그로 간주
  //       setIgnoreNextClick(true);
  //     }
  //     setDragging(false);
  //     localStorage.setItem('fabPosition', JSON.stringify(position));
  //   },
  //   [isDragging, position],
  // );
  //
  // // 전역 클릭 무시 처리
  // useEffect(() => {
  //   if (!ignoreNextClick) return;
  //   const handleClick = (e: MouseEvent) => {
  //     e.stopPropagation();
  //     e.preventDefault();
  //     setIgnoreNextClick(false); // 1회만
  //   };
  //   document.addEventListener('click', handleClick, true); // 캡처 단계에서 차단
  //   return () => document.removeEventListener('click', handleClick, true);
  // }, [ignoreNextClick]);

  useEffect(() => {
    if (isDragging) {
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    } else {
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    }

    return () => {
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', onMouseUp);
    };
  }, [isDragging, onMouseMove, onMouseUp]);

  useEffect(() => {
    const handleResize = () => {
      if (fabRef.current) {
        const fabWidth = fabRef.current.offsetWidth;
        const fabHeight = fabRef.current.offsetHeight;

        setPosition((currentPosition) => {
          const newPos = { ...currentPosition };

          if (newPos.x < 0) {
            newPos.x = 0;
          }
          if (newPos.y < 0) {
            newPos.y = 0;
          }
          if (newPos.x + fabWidth > window.innerWidth) {
            newPos.x = window.innerWidth - fabWidth;
          }
          if (newPos.y + fabHeight > window.innerHeight) {
            newPos.y = window.innerHeight - fabHeight;
          }

          if (newPos.x !== currentPosition.x || newPos.y !== currentPosition.y) {
            localStorage.setItem('fabPosition', JSON.stringify(newPos));
            return newPos;
          }

          return currentPosition;
        });
      }
    };

    window.addEventListener('resize', handleResize);
    handleResize(); // Also run on mount to handle initial positioning

    return () => {
      window.removeEventListener('resize', handleResize);
    };
  }, []);

  return (
    <div
      ref={fabRef}
      className={cn('fixed z-5000 flex flex-col items-center', 'w-[150px] md:w-[120px]')}
      style={{ left: position.x, top: position.y }}
      onMouseEnter={handleMouseEnter}
      onMouseLeave={handleMouseLeave}
    >
      {/* Action Button */}
      <div
        className={cn(
          'flex h-[50px] w-full cursor-grab items-center justify-center rounded-[8px] bg-gray-500 border border-gray-300 text-white shadow-lg transition-all duration-300 hover:opacity-80 opacity-70 text-black',
          'text-base font-bold md:h-[45px] md:text-sm',
          { 'cursor-grabbing scale-105': isDragging },
          actionBtn,
        )}
        onMouseDown={onMouseDown}
      >
        <span>{label}</span>
      </div>

      {/* Fab List */}
      <div
        className={cn(
          'pointer-events-none absolute left-0 w-full list-none p-0',
          'flex flex-col transition-all duration-500 ease-in-out',
          {
            'visible opacity-100': isListVisible,
            'invisible opacity-0': !isListVisible,
          },
          {
            'bottom-full mb-2': listDirection === 'up',
            'top-full mt-2': listDirection === 'down',
          },
          list,
        )}
      >
        {items.map((item, index) => (
          <button
            key={item.id}
            onClick={() => handleNavigate(item.path)}
            className={cn(
              'pointer-events-auto mb-2 cursor-pointer rounded-lg border border-gray-200 bg-white p-3 text-center text-gray-800 shadow-sm transition-all duration-200 ease-in-out hover:scale-100 text-black hover:opacity-80',
              {
                'translate-y-0 opacity-70': isListVisible,
                'opacity-0': !isListVisible,
                'translate-y-4': listDirection === 'up',
                '-translate-y-4': listDirection === 'down',
              },
              listItem,
            )}
            style={{ transitionDelay: isListVisible ? `${index * 75}ms` : '0ms' }}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>
  );
};
