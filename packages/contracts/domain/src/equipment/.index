export type ArmorEn = keyof typeof ArmorMap;
export type ArmorKo = (typeof ArmorMap)[ArmorEn];

type AccessorySlot = 'badge' | 'belt' | 'earrings' | 'emblem' | 'eye' | 'face' | 'medal' | 'pendant' | 'pocket' | 'powerSource' | 'ring' | 'shoulder';

