export type ItemCategory = 'armor' | 'accessory' | 'weapon' | 'pet' | 'arcane' | 'authentic';

type ArmorSlot = 'top' | 'bottom' | 'hat' | 'glove' | 'cape' | 'subWeapon' | 'shoes' | 'overall';
