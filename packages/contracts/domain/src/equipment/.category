type EquipmentSlot =
  /**
   * 방어구
   * 표시   : 전부
   **/
  | '모자'
  | '상의'
  | '하의'
  | '한벌옷'
  | '신발'
  | '장갑'
  | '망토'

  /**
   * 장신구
   * 표시   : 얼굴장식, 눈장식, 귀고리, 반지, 펜던트, 벨트
   * 비표시 : 훈장, 어깨장식, 포켓 아이템, 뱃지, 엠블렘, 파워소스
   **/
  | '얼굴장식'
  | '눈장식'
  | '귀고리'
  /**
   * - 반지: 반지1, 반지2, 반지3, 반지4
   **/
  | '반지1'
  | '반지2'
  | '반지3'
  | '반지4'
  /**
   * - 펜던트: 펜던트, 펜던트2
   **/
  | '펜던트'
  | '펜던트2'
  | '벨트'
  | '훈장'
  | '어깨장식'
  | '포켓 아이템'
  | '뱃지'
  | '엠블렘'
  | '파워소스'

  /**
   * 기타
   * 표시   : 메카닉 장비, 드래곤 장비
   * 비표시 : 기계 심장, 안드로이드
   **/
  // '메카닉 장비'
  | '메카닉 엔진' // 엔진
  | '메카닉 암' // 암
  | '메카닉 레그' // 레그
  | '메카닉 프레임' // 프레임
  | '메카닉 트랜지스터' // 트랜지스터
  // '드래곤 장비'
  | '드래곤 모자' // 드래곤 모자
  | '드래곤 펜던트' // 드래곤 펜던트
  | '드래곤 날개장식' // 날개장식
  | '드래곤 꼬리장식' // 꼬리장식
  //
  | '기계 심장'
  | '안드로이드'

  /** 무기
   * 표시   : 전부
   **/
  | '무기' /* 한손, 두손 */
  | '보조무기';
