{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated/**",
    "**/.*.ts",
    "**/.*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.legacy.ts",
    "**/*.legacy.tsx",
    "**/legacy",
    "**/legacy/**"
  ]
}
