{
  "name": "@maple/bootstrap",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "generate": "pnpm run generate:core-taxonomy",
    "generate:core-taxonomy": "tsx src/scripts/generate-core-taxonomy.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild-plugin-alias": "^0.2.1",
    "tsx": "^4.21.0",
    "tsup": "^8.5.0"
  }
}
