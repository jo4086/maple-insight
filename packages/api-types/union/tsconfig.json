{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated/**",
    "**/.*.ts",
    "**/.*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.legacy.ts",
    "**/*.legacy.tsx",
    "**/legacy",
    "**/legacy/**"
  ]
}
