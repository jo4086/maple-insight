{
  "name": "@maple/types",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./equipment": {
      "types": "./dist/equipment.d.ts",
      "import": "./dist/equipment.js",
      "require": "./dist/equipment.cjs"
    },
    "./character": {
      "types": "./dist/character.d.ts",
      "import": "./dist/character.js",
      "require": "./dist/character.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --watch",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "esbuild-plugin-alias": "^0.2.1",
    "tsup": "^8.5.0"
  }
}
