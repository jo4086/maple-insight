{
  "name": "@maple/calculator",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --reporter verbose",
    "test:stat": "vitest run src/base/character.test.ts --reporter verbose"
  },
  "dependencies": {
    "@maple/data-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^4.0.18"
  }
}
