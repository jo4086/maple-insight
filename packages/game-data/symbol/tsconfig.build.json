{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/generated/**",
    "**/.*.ts",
    "**/.*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.legacy.ts",
    "**/*.legacy.tsx",
    "**/legacy",
    "**/legacy/**"
  ]
}
