{
  "name": "@maple/data-admin",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "pretypecheck": "pnpm --filter @maple/db run build",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm --filter @maple/db run build",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --watch",
    "preexport:game-skills-by-raw-job": "pnpm --filter @maple/data-skill run build && pnpm --filter @maple/db run build",
    "export:game-skills-by-raw-job": "tsx src/export-game-skills-by-raw-job.ts",
    "preseed:boss": "pnpm --filter @maple/db run build",
    "seed:boss": "tsx src/seed-boss.ts",
    "seed:equipment": "tsx src/seed-equipment.ts",
    "preseed:game-data": "pnpm --filter @maple/db run build",
    "seed:game-data": "tsx src/seed-game-data.ts",
    "preseed:game-data-raw": "pnpm --filter @maple/db run build",
    "seed:game-data-raw": "tsx src/seed-game-data-raw.ts",
    "prisma:generate": "prisma generate",
    "lint": "eslint src --ext .ts"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@maple/data-skill": "workspace:*",
    "@maple/db": "workspace:*",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "esbuild-plugin-alias": "^0.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0"
  }
}
