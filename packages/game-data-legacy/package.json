{
  "name": "@maple/game-data",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./class": {
      "types": "./dist/class/index.d.ts",
      "import": "./dist/class/index.js",
      "require": "./dist/class/index.cjs"
    },
    "./equipment": {
      "types": "./dist/equipment/index.d.ts",
      "import": "./dist/equipment/index.js",
      "require": "./dist/equipment/index.cjs"
    },
    "./force": {
      "types": "./dist/force/index.d.ts",
      "import": "./dist/force/index.js",
      "require": "./dist/force/index.cjs"
    },
    "./monster": {
      "types": "./dist/monster/index.d.ts",
      "import": "./dist/monster/index.js",
      "require": "./dist/monster/index.cjs"
    },
    "./raw": {
      "types": "./dist/raw/index.d.ts",
      "import": "./dist/raw/index.js",
      "require": "./dist/raw/index.cjs"
    },
    "./stat": {
      "types": "./dist/stat/index.d.ts",
      "import": "./dist/stat/index.js",
      "require": "./dist/stat/index.cjs"
    },
    "./symbol": {
      "types": "./dist/symbol/index.d.ts",
      "import": "./dist/symbol/index.js",
      "require": "./dist/symbol/index.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup src/index.ts --dts --format esm,cjs --out-dir dist --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild-plugin-alias": "^0.2.1",
    "tsup": "^8.5.0"
  }
}
