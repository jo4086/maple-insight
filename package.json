{
  "name": "maple_repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages",
    "packages/*",
    "packages/api-types/*",
    "packages/contracts/*",
    "packages/database/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:pkgs": "pnpm --filter @maple/packages-workspace run typecheck",
    "lint:pkgs": "pnpm --filter @maple/packages-workspace run lint",
    "build:pkgs": "pnpm --filter @maple/packages-workspace run build",
    "convert:csv-json": "node scripts/convert-csv-to-json.mjs",
    "sync:package-entrypoints": "node scripts/sync-package-entrypoints.mjs"
  },
  "author": "jo4086",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.5",
      "typescript": "^5.9.3"
    }
  }
}
